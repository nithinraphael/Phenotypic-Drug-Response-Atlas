  "narrative": {
    "northStar": "Journal Figure Plates",
    "overview": "Journal figure plates guide the atlas: pale canvas, dark teal text and white plotting surfaces. PT Sans carries headings, controls and scientific labels. Figures have room for axes, units and legends; compact native controls keep the working conditions visible.\n\nThe interface uses marimo tabs, selectors, tables and disclosures with a small CSS layer. Existing microscopy supplies the imagery. Color, symbols, line styles and captions distinguish observations, fitted responses and conditioned predictions.",
    "keyCharacteristics": [
      "White figure plates on a pale scientific canvas.",
      "Native controls and responsive comparison layouts.",
      "Explicit scientific labels and restrained evidence colors."
    ],
    "rules": [
      {
        "name": "The Evidence Color Rule",
        "body": "Pair evidence color with a legend label and, for response curves, marker or line style. Amber denotes a fitted effect span, never uncertainty.",
        "section": "colors"
      },
      {
        "name": "The Native Control Rule",
        "body": "Keep marimo interaction behavior; apply the atlas type, sizing and focus treatment without rebuilding the widget.",
        "section": "components"
      }
    ],
    "dos": [
      "Do retain native marimo controls and visible keyboard focus.",
      "Do label axes, units, conditions and evidence types in figures and captions.",
      "Do keep microscopy provenance and display adjustments visible.",
      "Do distinguish measurements, fits, conditioned predictions and fitted effect spans."
    ],
    "donts": [
      "Don't present fitted effect spans as confidence intervals or biological tipping points.",
      "Don't imply PRISM viability and BBBC021 microscopy are paired assays.",
      "Don't add decorative imagery or custom JavaScript to this interface.",
      "Don't manufacture unavailable uncertainty, embeddings or external comparisons."
    ]
  }
